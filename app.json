{
  "expo": {
    "name": "Clube IAkí",
    "slug": "iaki",
    "version": "1.0.1",

    "orientation": "portrait",

    "icon": "./src/assets/icon-fixed.png",

    "androidStatusBar": {
      "translucent": false,
      "backgroundColor": "#F2F8FB",
      "barStyle": "dark-content"
    },

    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#F2F8FB"
    },

    "updates": {
      "fallbackToCacheTimeout": 0
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "assetBundlePatterns": ["**/*"],

    "ios": {
      "bundleIdentifier": "com.club.iaki",
      "buildNumber": "1"
    },

    "android": {
      "package": "com.club.iaki",
      "versionCode": 1,

      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon-fixed.png",
        "backgroundColor": "#F2F8FB"
      },

      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },

    "web": {
      "bundler": "metro"
    },

    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Precisamos acessar suas fotos para anexar seu avatar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],

      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Precisamos da sua localização para encontrar lojas próximas."
        }
      ],

      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#F2F8FB"
        }
      ],

      "expo-font",
      "expo-asset"
    ],

    "newArchEnabled": true,

    "extra": {
      "eas": {
        "projectId": "eef26f23-cf39-415d-b47d-1efedaa2354a"
      }
    },

    "owner": "grejaninflorencio"
  }
}
