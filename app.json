{
  "expo": {
    "name": "Clube IAki",
    "slug": "iaki",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./src/assets/icon-fixed.png",
    "androidStatusBar": {
      "translucent": false,
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#F2F8FB"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.club.iaki",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.club.iaki",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon-fixed.png",
        "backgroundColor": "#F2F8FB"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Precisamos acessar suas fotos para anexar seu avatar."
        }
      ],
      [
        "expo-location",
        {
          "locationPermission": "Precisamos da sua localização para encontrar lojas próximas."
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "newArchEnabled": true,
    "runtimeVersion": "1.0.0",
    "extra": {
      "eas": {
        "projectId": "eef26f23-cf39-415d-b47d-1efedaa2354a"
      }
    },
    "owner": "grejaninflorencio"
  }
}
